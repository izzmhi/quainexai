# ---------------------------------------------------------------------------
# Quainex configuration
#
# Copy this file to `.env` and fill in real values.
# `.env` is gitignored and must NEVER be committed.
#
#     copy .env.example .env        (cmd)
#     Copy-Item .env.example .env   (PowerShell)
# ---------------------------------------------------------------------------

# --- Application ---------------------------------------------------------
# Free-text display name for the app.
QUAINEX_APP_NAME=Quainex

# One of: dev | prod
# `dev` enables console-friendly logs, auto-reload and the /docs UI.
QUAINEX_ENVIRONMENT=dev

# Verbose error surfaces. Force-disabled when ENVIRONMENT=prod.
QUAINEX_DEBUG=true

# --- HTTP server ---------------------------------------------------------
# 127.0.0.1 binds to this machine only. Do NOT use 0.0.0.0 until Phase 6
# adds authentication — that would expose the API to your whole network.
QUAINEX_HOST=127.0.0.1
QUAINEX_PORT=8000

# --- Logging -------------------------------------------------------------
# One of: DEBUG | INFO | WARNING | ERROR | CRITICAL
QUAINEX_LOG_LEVEL=INFO

# Directory for rotating JSON log files (relative paths resolve to repo root).
QUAINEX_LOG_DIR=logs

# --- AI provider ---------------------------------------------------------
# Which provider backs the Brain. Currently only `anthropic` is implemented.
QUAINEX_AI_PROVIDER=anthropic

# Get a key at https://console.anthropic.com/settings/keys
# Leave blank to run Quainex without AI features (the API still boots).
QUAINEX_ANTHROPIC_API_KEY=

# Model used by the Brain. See https://docs.claude.com for current model IDs.
QUAINEX_AI_MODEL=claude-opus-5

# Reasoning effort: low | medium | high | xhigh | max
# The main cost/latency lever. `low` and `medium` are strong on current models;
# raise it only if the Brain starts misreading ambiguous commands.
QUAINEX_AI_EFFORT=medium

# Upper bound on tokens per AI response. This budget covers the model's internal
# reasoning as well as the visible answer, so keep it generous — too low and
# responses truncate mid-thought.
QUAINEX_AI_MAX_TOKENS=8192
