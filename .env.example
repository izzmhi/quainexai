# ---------------------------------------------------------------------------
# Quainex configuration
#
# Copy this file to `.env` and fill in real values.
# `.env` is gitignored and must NEVER be committed.
#
#     copy .env.example .env        (cmd)
#     Copy-Item .env.example .env   (PowerShell)
# ---------------------------------------------------------------------------

# --- Application ---------------------------------------------------------
# Free-text display name for the app.
QUAINEX_APP_NAME=Quainex

# One of: dev | prod
# `dev` enables console-friendly logs, auto-reload and the /docs UI.
QUAINEX_ENVIRONMENT=dev

# Verbose error surfaces. Force-disabled when ENVIRONMENT=prod.
QUAINEX_DEBUG=true

# --- HTTP server ---------------------------------------------------------
# 127.0.0.1 binds to this machine only. Setting anything else turns
# authentication ON automatically, and Quainex refuses to start without a
# password configured — so you cannot expose it by accident. See the auth
# section below.
QUAINEX_HOST=127.0.0.1
QUAINEX_PORT=8000

# --- Logging -------------------------------------------------------------
# One of: DEBUG | INFO | WARNING | ERROR | CRITICAL
QUAINEX_LOG_LEVEL=INFO

# Directory for rotating JSON log files (relative paths resolve to repo root).
QUAINEX_LOG_DIR=logs

# --- Dashboard -----------------------------------------------------------
# The browser interface, served at /ui/ (a bare / redirects there). Set this to
# false for an API-only deployment; the mount is simply skipped.
QUAINEX_SERVE_DASHBOARD=true
QUAINEX_DASHBOARD_DIR=dashboard

# --- AI providers --------------------------------------------------------
# You do not have to set any of these here. Open http://127.0.0.1:8000/ui/ and
# paste your keys into the Settings panel instead — they are encrypted with
# Windows DPAPI, take effect immediately without a restart, and never touch this
# file. Keys set here still work, and the dashboard shows which source each came
# from. The vault wins when both are set.
#
# Providers are tried in this order and the first one that HAS A KEY answers.
# Free tiers lead deliberately: Quainex should be fully usable before you have
# paid for anything. Reorder freely; an entry with no key is skipped.
# QUAINEX_AI_PROVIDERS=["groq", "gemini", "openrouter", "anthropic", "local"]

# --- Groq: free, fastest. Tried first. -----------------------------------
# Get a key at https://console.groq.com/keys
# Structured output here is prompt-guided rather than enforced by the API, which
# is why Gemini and Anthropic rank above it for anything schema-critical.
QUAINEX_GROQ_API_KEY=
QUAINEX_GROQ_MODEL=llama-3.3-70b-versatile

# --- Google Gemini: free, native schemas, and vision ---------------------
# Get a key at https://aistudio.google.com/apikey
# The first provider in the default order that can answer "what's on my screen?"
QUAINEX_GEMINI_API_KEY=
QUAINEX_GEMINI_MODEL=gemini-2.0-flash

# --- OpenRouter: free tier, one key for many vendors ---------------------
# Get a key at https://openrouter.ai/keys
#
# Free slugs come and go: a model that is free today can return 404 with "the
# paid version is available now" next month. Browse the current list at
# https://openrouter.ai/models?max_price=0
#
# `openrouter/free` auto-routes among whatever is free and so never goes stale,
# at the cost of not knowing which model answers. The default below was tested
# against the live API, structured output included.
QUAINEX_OPENROUTER_API_KEY=
QUAINEX_OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# --- Anthropic: paid, strongest reasoning. The backstop. -----------------
# Get a key at https://console.anthropic.com/settings/keys
# Leave every key blank to run Quainex without AI features — the API still boots
# and every non-AI command still works.
QUAINEX_ANTHROPIC_API_KEY=

# Model used when Anthropic answers. See https://docs.claude.com for model IDs.
QUAINEX_AI_MODEL=claude-opus-5

# --- Local / self-hosted: fully offline, nothing leaves the machine -------
# Any OpenAI-compatible server. For Ollama:  ollama serve && ollama pull llama3.1
# Unlike the hosted providers above, this one needs a URL: it points at a server
# only you know about, so there is no default. A key alone does nothing here.
# QUAINEX_LOCAL_BASE_URL=http://127.0.0.1:11434/v1
# QUAINEX_LOCAL_MODEL=llama3.1

# Where keys saved from the dashboard are stored, encrypted. Kept outside the
# repo so it can never be committed.
# QUAINEX_CREDENTIALS_PATH=C:/Users/G8/.quainex/credentials.dat

# Reasoning effort: low | medium | high | xhigh | max
# The main cost/latency lever. `low` and `medium` are strong on current models;
# raise it only if the Brain starts misreading ambiguous commands.
QUAINEX_AI_EFFORT=medium

# Upper bound on tokens per AI response. This budget covers the model's internal
# reasoning as well as the visible answer, so keep it generous — too low and
# responses truncate mid-thought.
QUAINEX_AI_MAX_TOKENS=8192

# --- Brain (Phase 2) -----------------------------------------------------
# Classifications below this confidence still return their best guess, but are
# flagged as needing your confirmation before Quainex acts on them.
QUAINEX_BRAIN_CONFIDENCE_THRESHOLD=0.6

# --- Commands (Phase 3) --------------------------------------------------
# Master switch for irreversible power actions (shutdown, restart, sleep).
# Leave false unless you want Quainex to be able to power off this machine.
# Even when true, those actions still require per-action confirmation.
QUAINEX_ALLOW_DESTRUCTIVE_COMMANDS=false

# Grace period before a scheduled shutdown or restart fires. During this window
# `shutdown /a` cancels it — your last line of defence against a misheard word.
QUAINEX_SHUTDOWN_DELAY_SECONDS=15

# Folders that file search and folder-opening are confined to. Anything outside
# these is refused. JSON array; defaults to your home directory.
# QUAINEX_COMMAND_SEARCH_ROOTS=["C:/Users/G8/Documents", "C:/Users/G8/dev"]

# Maximum results returned by a file search.
QUAINEX_COMMAND_SEARCH_MAX_RESULTS=50

# Where screenshots are saved. Defaults to <home>/Pictures/Quainex.
# QUAINEX_SCREENSHOT_DIR=C:/Users/G8/Pictures/Quainex

# --- Voice (Phase 4) -----------------------------------------------------
# Requires the optional extras:  pip install -e ".[voice]"
# Quainex runs fine without them; the voice subsystem just reports unavailable.

# What Quainex answers to. Matching is fuzzy, so mishearings still work.
QUAINEX_WAKE_WORD=quainex

# Require the wake word before acting on speech. Turn off only for
# push-to-talk clients, where pressing the button is itself the address.
QUAINEX_VOICE_REQUIRE_WAKE_WORD=true

# Hold the microphone open at startup and act on anything beginning with the
# wake word, so "Quainex, take a screenshot" works with nothing pressed.
#
# Off by default on purpose. Speech is transcribed on this machine and discarded
# unless it was addressed to Quainex - nothing is uploaded, nothing is stored,
# and unaddressed speech costs no API tokens because the wake gate returns
# before the Brain is called. But an open microphone is a fact about the room,
# and other people in it have not agreed to it. Turn it on knowingly.
#
# Also toggleable at any time from the Console panel, without a restart.
QUAINEX_VOICE_ALWAYS_LISTENING=false

# Recording stops this long after you stop speaking; max_seconds caps a
# microphone stuck open.
QUAINEX_VOICE_SILENCE_SECONDS=1.2
QUAINEX_VOICE_MAX_SECONDS=15
# RMS amplitude below which audio counts as silence. Raise it in a noisy room.
QUAINEX_VOICE_SILENCE_THRESHOLD=350

# Recordings are deleted after transcription unless you set this to true.
QUAINEX_KEEP_RECORDINGS=false

# Whisper model: tiny | base | small | medium | large-v3
# Larger is more accurate, slower, and a bigger first-run download.
QUAINEX_WHISPER_MODEL=base

# Speech output. Rate is -10 (slow) to 10 (fast). Leave voice blank for the
# Windows default; run `Get-InstalledVoice` in PowerShell to see the options.
QUAINEX_TTS_ENABLED=true
QUAINEX_TTS_RATE=0
# QUAINEX_TTS_VOICE=Microsoft Zira Desktop

# --- Remote access and auth (Phase 6) ------------------------------------
# Generate BOTH of these with:  python scripts/hash_password.py
# They are required whenever QUAINEX_HOST is not a loopback address; Quainex
# refuses to start otherwise rather than listening on your network unguarded.
#
# QUAINEX_AUTH_PASSWORD_HASH=scrypt$32768$8$1$...
# QUAINEX_AUTH_SECRET=...

# How long an access token stays valid.
QUAINEX_AUTH_TOKEN_TTL_MINUTES=60

# Force authentication on even for localhost. Leave unset to derive it from the
# bind address, which is the safer default.
# QUAINEX_REQUIRE_AUTH=true

# Requests per client per minute once authentication is in force. Localhost is
# never rate limited.
QUAINEX_RATE_LIMIT_PER_MINUTE=120

# How long a command-confirmation token stays redeemable.
QUAINEX_CONFIRMATION_TTL_SECONDS=120

# --- Memory (Phase 5) ----------------------------------------------------
# SQLite file location. Relative paths resolve to the repo root, and the file
# is gitignored — it holds your conversations.
QUAINEX_DATABASE_PATH=quainex.db

# Point at PostgreSQL later without touching code:
# QUAINEX_DATABASE_URL_OVERRIDE=postgresql+asyncpg://user:pass@localhost/quainex

# How many recent turns the Brain sees as context. Enough to resolve "close it"
# after "open Spotify"; bounded so token cost stays flat however long you talk.
QUAINEX_MEMORY_CONTEXT_TURNS=6

# --- Telegram: control Quainex from your phone ---------------------------
# The bot token and the allowlist are stored encrypted by the dashboard
# (Settings -> Phone control), not here. Only the behaviour switches live here.

# Start polling when Quainex starts. Off by default because a process that begins
# accepting remote commands the instant it boots is not something to inherit
# without choosing it.
QUAINEX_TELEGRAM_AUTOSTART=false

# Upload the actual image when a screenshot is taken from Telegram, rather than
# replying with the saved file path.
#
# This sends a picture of your screen to Telegram's servers, and the Bot API is
# not end-to-end encrypted — the image is readable by Telegram and stays in your
# chat history until you delete it. Whatever was on screen goes with it.
#
# Worth it to see your machine from anywhere, and the owner's call to make. Off
# by default so nobody meets this behaviour by surprise.
QUAINEX_TELEGRAM_SEND_SCREENSHOTS=false
